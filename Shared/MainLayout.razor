@inherits LayoutComponentBase

<PageTitle>Git-Friendly</PageTitle>

<div class="min-h-screen flex flex-col md:flex-row bg-zinc-950 text-white font-sans antialiased">
    <!-- Left Sidebar Container -->
    <NavMenu />

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
        <!-- Top Navigation Bar / Header -->
        <header class="h-16 px-6 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur flex items-center justify-end shrink-0">
            <a href="https://docs.microsoft.com/aspnet/" 
               target="_blank" 
               rel="noopener noreferrer"
               class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">
                About
            </a>
        </header>

        <!-- Main Page Body -->
        <main class="flex-1 p-6 md:p-10 overflow-y-auto">
            <article class="max-w-7xl mx-auto">
                @Body
            </article>
        </main>
    </div>
</div>