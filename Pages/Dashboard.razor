@page "/dashboard"
@using MyBlazorApp.Shared
<head>
    <link rel="stylesheet" href="css/app.css" />
</head>
<div class="app-viewport">
    <div class="dashboard-container">
        
        <!-- Header Nav -->
        <div class="dashboard-header">
            <BrandLogo />
            
            <input type="text" class="search-input" placeholder="Search Repository..." @bind="searchQuery" />

            <button class="nav-icon-btn" title="Add New">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
            </button>

            <button class="nav-icon-btn" title="GitHub">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </svg>
            </button>

            <button class="nav-icon-btn" title="Profile">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                </svg>
            </button>

            <button class="nav-icon-btn" title="Next">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                </svg>
            </button>
        </div>

        <!-- Section Content -->
        <div class="dashboard-content">
            <div class="section-label">Recently Opened:</div>

            @if (recentlyOpenedItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <p>No recently opened items.</p>
                </div>
            }
            else
            {
                <div class="cards-grid">
                    @foreach (var item in recentlyOpenedItems)
                    {
                        <div class="repo-card">
                            <div class="repo-card-preview">
                                🔒 Repository Preview Content...
                            </div>
                            <div class="repo-card-title">@item</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private List<string> recentlyOpenedItems = new();
}