@page "/dashboard"
@using GitFriendly.Shared
@inject NavigationManager Nav

<PageTitle>Dashboard - GitFriendly</PageTitle>

<!-- .app-viewport -->
<div class="bg-[#000000] min-h-screen flex items-center justify-center p-8 font-sans antialiased text-white">
    
    <!-- .dashboard-container -->
    <div class="bg-[#1b1b1e] border border-[#2a2a2d] rounded-[20px] w-full max-w-[900px] min-h-[520px] relative shadow-[0_20px_40px_rgba(0,0,0,0.8)] box-border p-5 flex flex-col">
        
        <!-- .dashboard-header -->
        <div class="flex items-center gap-3 w-full">
            <BrandLogo />
            
            <!-- .search-input -->
            <input type="text" 
                   class="flex-grow bg-[#121214] border-[1.5px] border-[#2a2a2d] rounded-full px-5 py-2.5 text-white text-[0.95rem] font-semibold outline-none placeholder-[#8e8e93] focus:border-[#55555c] focus:bg-[#161619] transition-all" 
                   placeholder="Search Repository..." 
                   @bind="searchQuery" 
                   @bind:event="oninput" />

            <!-- .nav-icon-btn (Add New) -->
            <button class="bg-[#000000] border border-[#2a2a2d] rounded-xl w-[44px] h-[44px] shrink-0 flex items-center justify-center text-white cursor-pointer hover:border-[#55555c] transition-colors" title="Add New">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
            </button>

            <!-- .nav-icon-btn (GitHub) -->
            <button class="bg-[#000000] border border-[#2a2a2d] rounded-xl w-[44px] h-[44px] shrink-0 flex items-center justify-center text-white cursor-pointer hover:border-[#55555c] transition-colors" title="GitHub">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </svg>
            </button>

            <!-- .nav-icon-btn (Profile) -->
            <button class="bg-[#000000] border border-[#2a2a2d] rounded-xl w-[44px] h-[44px] shrink-0 flex items-center justify-center text-white cursor-pointer hover:border-[#55555c] transition-colors" title="Profile">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                </svg>
            </button>

            <!-- .nav-icon-btn (Logout) -->
            <button class="bg-[#000000] border border-[#2a2a2d] rounded-xl w-[44px] h-[44px] shrink-0 flex items-center justify-center text-white cursor-pointer hover:border-[#55555c] transition-colors" title="Logout" @onclick="Logout">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                </svg>
            </button>
        </div>

        <!-- .dashboard-content -->
        <div class="mt-6 px-2">
            <!-- .section-label -->
            <div class="text-[1.1rem] font-bold mb-5 text-white">Recently Opened:</div>

            @if (recentlyOpenedItems.Count == 0)
            {
                <div class="text-center py-12 text-[#8e8e93]">
                    <p class="text-sm font-semibold">No recently opened items.</p>
                </div>
            }
            else
            {
                <!-- .cards-grid -->
                <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
                    @foreach (var item in recentlyOpenedItems)
                    {
                        <!-- .repo-card -->
                        <div class="bg-[#0d0d0f] border border-[#2a2a2d] rounded-2xl overflow-hidden flex flex-col">
                            <!-- .repo-card-preview -->
                            <div class="bg-[#121214] h-[110px] border-b border-[#2a2a2d] p-3 text-[0.65rem] text-[#8e8e93] overflow-hidden">
                                🔒 Repository Preview Content...
                            </div>
                            <!-- .repo-card-title -->
                            <div class="bg-white text-black font-bold text-center py-2 px-3 text-[0.9rem]">
                                @item
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private List<string> recentlyOpenedItems = new();

    private void Logout()
    {
        Nav.NavigateTo("/login");
    }
}