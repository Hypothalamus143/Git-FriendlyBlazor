@page "/register"
@using GitFriendly.Models
@using GitFriendly.Shared
@inject NavigationManager Nav
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants
<head>
    <link rel="stylesheet" href="css/app.css" />
</head>
<div class="d-flex justify-content-center align-items-center vh-100 p-3">
    <div class="auth-container">
        <div class="top-left-logo">
            <BrandLogo />
        </div>

        <h2 class="form-title">Register</h2>

        <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
            <DataAnnotationsValidator />

            <InputText class="custom-input" placeholder="Username" @bind-Value="registerModel.Username" />
            <ValidationMessage For="@(() => registerModel.Username)" class="text-danger mb-2" />

            <InputText class="custom-input" type="password" placeholder="Password" @bind-Value="registerModel.Password" />
            <ValidationMessage For="@(() => registerModel.Password)" class="text-danger mb-2" />

            <InputText class="custom-input" type="password" placeholder="Confirm Password" @bind-Value="registerModel.ConfirmPassword" />
            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger mb-2" />

            <button type="submit" disabled="@saving" class="btn-submit">Create Account</button>
        </EditForm>

        <a class="auth-footer-link" @onclick='() => Nav.NavigateTo("/login")'>Login</a>
    </div>
    <p>@message</p>
</div>

@code {
    private UserRegisterModel registerModel = new();
    string message = "";
    bool saving = false;
    List<User> users = new();

    async Task GetUsers(string username)
  {
    var res = await Db.From<User>()
        .Where(u => u.Username==username)
        .Get();
    users = res.Models;
  }
    
    async Task RegisterUser(string username, string password){
        if(string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password)){
            message = "username or password cannot be empty";
            return;
        }
        saving = true;
        await Db.From<User>().Insert(new User
          {
            Username = username,
            Password = password
          });
        saving = false;
    }
    async private void HandleRegistration()
    {
    await GetUsers(registerModel.Username);
        if(users.Count > 0) message = "Invalid Username or Password";
        else if(registerModel.Password != registerModel.ConfirmPassword) message = "Passwords don't match";
        else{
            await RegisterUser(registerModel.Username, registerModel.Password);
            Nav.NavigateTo("/login");
        }
    }
}