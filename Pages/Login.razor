@page "/login"
@page "/"
@using GitFriendly.Models
@using GitFriendly.Shared
@using GitFriendly.Services
@inject NavigationManager Nav
@inject Supabase.Client Db
@inject SessionState session
@using static Supabase.Postgrest.Constants
<head>
    <link rel="stylesheet" href="css/app.css" />
</head>
<div class="d-flex justify-content-center align-items-center vh-100 p-3">
    <div class="auth-container">
        <div class="top-left-logo">
            <BrandLogo />
        </div>

        <h2 class="form-title">Sign In</h2>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
            <DataAnnotationsValidator />

            <InputText class="custom-input" placeholder="Username" @bind-Value="loginModel.Username" />
            <ValidationMessage For="@(() => loginModel.Username)" class="text-danger mb-2" />

            <InputText class="custom-input" type="password" placeholder="Password" @bind-Value="loginModel.Password" />
            <ValidationMessage For="@(() => loginModel.Password)" class="text-danger mb-2" />

            <button type="submit" class="btn-submit">Log In</button>
        </EditForm>

        <a class="auth-footer-link" @onclick='() => Nav.NavigateTo("/register")'>Create Account</a>
    </div>
    <p>@message</p>
</div>

@code {
    private UserLoginModel loginModel = new();
    string message = "";
    List<User> users = new();

    async Task GetUsers(string username, string password)
  {
    var res = await Db.From<User>()
        .Where(u => u.Username==username && u.Password==password)
        .Get();
    users = res.Models;
  }
    
    
    async private void HandleLogin()
    {
    await GetUsers(loginModel.Username, loginModel.Password);

    if(users.Count > 0){
        session.currentUser = users.First();
        Nav.NavigateTo("/dashboard");
    }
    else message = "Invalid Username or Password";
    }

}