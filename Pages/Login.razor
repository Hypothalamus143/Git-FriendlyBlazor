@page "/login"
@page "/"
@using MyBlazorApp.Models
@using MyBlazorApp.Shared
@inject NavigationManager Nav
<head>
    <link rel="stylesheet" href="css/app.css" />
</head>
<div class="d-flex justify-content-center align-items-center vh-100 p-3">
    <div class="auth-container">
        <div class="top-left-logo">
            <BrandLogo />
        </div>

        <h2 class="form-title">Sign In</h2>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
            <DataAnnotationsValidator />

            <InputText class="custom-input" placeholder="Username" @bind-Value="loginModel.Username" />
            <ValidationMessage For="@(() => loginModel.Username)" class="text-danger mb-2" />

            <InputText class="custom-input" type="password" placeholder="Password" @bind-Value="loginModel.Password" />
            <ValidationMessage For="@(() => loginModel.Password)" class="text-danger mb-2" />

            <button type="submit" class="btn-submit">Log In</button>
        </EditForm>

        <a class="auth-footer-link" @onclick='() => Nav.NavigateTo("/register")'>Create Account</a>
    </div>
</div>

@code {
    private UserLoginModel loginModel = new();

    private void HandleLogin()
    {
        Nav.NavigateTo("/dashboard");
    }
}