@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace GitFriendly.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950 text-white">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    
    <!-- Tailwind Compiled Stylesheet -->
    <link rel="stylesheet" href="css/app.css" />
    
    
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="h-full antialiased bg-zinc-950 text-white">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <!-- Styled Blazor Error UI -->
    <div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 right-0 z-50 p-4 bg-red-900/90 border-t border-red-700 text-white backdrop-blur flex items-center justify-between">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <div class="flex items-center gap-3">
            <a href="" class="reload px-3 py-1 bg-red-800 hover:bg-red-700 text-white text-xs font-semibold rounded-md transition-colors">Reload</a>
            <a class="dismiss cursor-pointer text-red-200 hover:text-white font-bold text-lg">🗙</a>
        </div>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>