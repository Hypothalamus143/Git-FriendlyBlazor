@page
@model GitFriendly.Pages.ErrorModel

<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950 text-white">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Error - GitFriendly</title>
    
    <!-- Link to your Tailwind output -->
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="h-full antialiased bg-zinc-950 text-zinc-100 flex items-center justify-center p-6">
    <div class="max-w-2xl w-full bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-2xl space-y-6">
        
        <!-- Header / Error Alert Badge -->
        <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                Application Error
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white">An error occurred.</h1>
            <p class="text-zinc-400">An unexpected exception was thrown while processing your request.</p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="p-4 bg-zinc-950/80 border border-zinc-800/80 rounded-xl flex items-center justify-between text-sm">
                <span class="text-zinc-400 font-medium">Request ID</span>
                <code class="px-2.5 py-1 bg-zinc-800 rounded-md text-amber-400 font-mono text-xs">@Model.RequestId</code>
            </div>
        }

        <!-- Development Mode Information Box -->
        <div class="p-5 bg-zinc-800/40 border border-zinc-800 rounded-xl space-y-3">
            <h2 class="text-sm font-semibold text-zinc-200 uppercase tracking-wider">Development Mode Notice</h2>
            <p class="text-sm text-zinc-400 leading-relaxed">
                Swapping to the <strong class="text-zinc-200">Development</strong> environment displays detailed information about the error that occurred.
            </p>
            <p class="text-sm text-zinc-400 leading-relaxed">
                <strong class="text-amber-400">Warning:</strong> The Development environment shouldn't be enabled for deployed applications as it can expose sensitive exception details to end users.
            </p>
            <p class="text-xs text-zinc-500 leading-relaxed pt-2 border-t border-zinc-800">
                To enable local debugging, set the <code class="text-zinc-300 font-mono">ASPNETCORE_ENVIRONMENT</code> environment variable to <code class="text-zinc-300 font-mono">Development</code> and restart the app.
            </p>
        </div>

        <!-- Back Link -->
        <div class="pt-2">
            <a href="/" class="inline-flex items-center justify-center px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm rounded-lg shadow-lg shadow-indigo-600/20 transition-all">
                Return to Safety
            </a>
        </div>

    </div>
</body>

</html>